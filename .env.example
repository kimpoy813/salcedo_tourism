# ==============================================================================
# Project CEDO: Turi App — Environment Variables Template
# Municipality of Salcedo, Ilocos Sur, Philippines
# ==============================================================================

# 1. Neon Serverless PostgreSQL (Required in Production / Staging)
# Pooled connection string from Neon Dashboard or Vercel Neon Integration
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string for Drizzle Kit migrations
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Local development / test fallback (used ONLY when DATABASE_URL is unset and USE_PGLITE=true)
# USE_PGLITE="true"

# 2. Vercel Blob Storage (Media Library & Tourism Photo Uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# 3. Admin Authentication & Cryptography
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-cryptographically-random-32-plus-char-secret"

# 4. Initial Admin Account Seed Credentials (override before running db:seed in production!)
ADMIN_USERNAME="cedo_superadmin"
ADMIN_EMAIL="tourism@salcedo-ilocossur.gov.ph"
ADMIN_PASSWORD="ChangeMe-StrongPassword-2026!"

TOURISM_ADMIN_USERNAME="tourism_officer"
TOURISM_ADMIN_PASSWORD="ChangeMe-TourismOfficer-2026!"

EDITOR_USERNAME="cedo_editor"
EDITOR_PASSWORD="ChangeMe-ContentEditor-2026!"

DATA_OFFICER_USERNAME="data_officer"
DATA_OFFICER_PASSWORD="ChangeMe-DataOfficer-2026!"

# 5. Public App URL (used for metadata, OpenGraph, and PWABuilder verification)
NEXT_PUBLIC_APP_URL="https://salcedo-turi.vercel.app"
